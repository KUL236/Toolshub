# ToolHub 5D — Environment Variables Template
# Copy this file to .env.local for local development (never commit .env.local)
# In production, set these in your Netlify dashboard → Site Settings → Environment Variables

# ── Supabase (public/anon key — safe for browser) ──────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..._YOUR_ANON_KEY_HERE

# ── Groq AI (SECRET — server-side only, never expose to browser) ───────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── OCR.space (SECRET — server-side only, never expose to browser) ─────────
OCR_API_KEY=your_ocr_space_api_key_here

# ── Hugging Face (SECRET — server-side only, never expose to browser) ──────
# Used by netlify/functions/huggingface.js for: AI Image Generator, AI
# Background Remover, AI Image Enhancer, AI Image Upscaler, AI Logo
# Generator, AI Icon Generator, and the Subtitle Generator video tool.
# Get a free token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# ── Spotify (SECRET — server-side only, never expose to browser) ───────────
# Used by netlify/functions/spotify-search.js for the "Playlist Player" tool's
# search-by-song-name feature. Free — create an app at
# https://developer.spotify.com/dashboard, then copy its Client ID + Secret.
# (Not needed if you only want to paste Spotify links directly — that part
# works with no key at all.)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
